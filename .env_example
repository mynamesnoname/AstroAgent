###############################################################################
# overall Configuration
###############################################################################
# Retry Configuration
MAX_TRIES=3
# Retry delay in seconds
RETRY_DELAY=180
# Redrock redshift fitter: set to true to use Redrock for hypothesis generation
# Default: false
REDROCK=false
# Redrock template directory (required if REDROCK=true)
RR_TEMPLATE_DIR=
# Archetype directory (optional, used when USE_ARCHETYPES=true)
ARCHETYPE_DIR=
# Use archetypes in redrock fitting (default: true)
USE_ARCHETYPES=true
# Number of redshift minima to explore (default: 9)
NMINIMA=9
# Number of nearest archetypes (default: 2)
NNEAREST=2
# OMP threads for redrock (default: 1)
OMP_NUM_THREADS=1

###############################################################################
# LLM Configuration
###############################################################################

# LLM Configuration
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# LLM_TEMPERATURE Default is 0.1
LLM_TEMPERATURE=
# LLM_MAX_TOKENS Default is None
LLM_MAX_TOKENS=
# LLM Thinking
# - disabled: 关闭思考模式，回避多轮工具调用中 reasoning_content 回传问题
# - enabled: 开启思考模式
# - none: Recommend for Qwen series
LLM_THINKING=disabled

# VLM Configuration # leave it empty
# VLM_API_KEY=
# VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# VLM_MODEL=qwen-vl-max
# VIS_LLM_TEMPERATURE Default is 0.1
# VLM_TEMPERATURE=
# VIS_LLM_MAX_TOKENS Default is None
# VLM_MAX_TOKENS=
# VLM_THINKING=none

################################################################################
# IO Configuration
################################################################################
# Run mode, single run or batch run
# RUN=s or b
# s for single run, b for batch run
RUN_MODE=s

# Input Directory
# Directory where input files are stored
INPUT_DIR=/home/wbc/code3/llm-spectro-agent_advance/data/QSO/fits_input
INPUT_FORMAT=fits
# Output Directory
# Directory where results will be stored
OUTPUT_DIR=/home/wbc/code3/llm-spectro-agent_advance/data/output

# Single mode parameters
# If RUN=s, set the fits name to be processed (e.g., set FILE_NAME=QSO for QSO.fits)
# Fits name for a single fits (without extension name)
FILE_NAME=

# Batch mode parameters
# If you set RUN=b, and your fits are named QSO_0.fits to QSO_100.fits, set the following:
# BATCH_HEADER=QSO_             # Base name for a series of fits, leave it empty if you don't have a header
# BATCH_START=0                 # Starting index of the fits series
# BATCH_END=100                 # Ending index of the fits series
# The program will automatically jump the fits if the fits does not exist.
FILE_BATCH_HEADER=
FILE_BATCH_START=
FILE_BATCH_END=

################################################################################
# Parameters
################################################################################

# Harness concurrency: number of hypotheses analysed in parallel during the
# LLM targeted-search stage inside RuleAnalyst.
# Each harness invocation is an independent LangGraph agent call (tool-use loop).
# Lower = less API load, higher = faster throughput.
# Default: 50
HARNESS_CONCURRENCY=50

# --- Self-evolution / ground-truth comparison ---
# SELF_EVOLVE: set to true to enable the self-evolution (反思) pathway.
# When enabled, the pipeline compares synthesis results against ground truth
# and records failures for batch root-cause analysis.
# Default: false
SELF_EVOLVE=false
# FAILURE_BATCH_SIZE: number of failed samples to accumulate before running a
# collective batch root-cause analysis.  Default: 5
FAILURE_BATCH_SIZE=5
# Set all three below to provide ground truth for each sample.
# EXPECTED_Z: ground-truth redshift (float)
EXPECTED_Z=
# EXPECTED_TYPE: ground-truth classification. One of:
#   QSO, Galaxy (ELG), Galaxy (LRG/BGS), Star
EXPECTED_TYPE=
# Z_TOLERANCE: acceptable redshift error. Default 0.005 if unset.
Z_TOLERANCE=0.005

# Camera information, unit should align with the input .png file.
# You can leave it empty if you don't have the information.
# e.g. for DESI:
# ARM_NAME = B,R,Z
# ARM_WAVELENGTH_RANGE = 3600-5800,5760-7620,7520-9824
# for CSST:
# ARM_NAME = U,V,I
# ARM_WAVELENGTH_RANGE = 2450-4200,3800-6600,6100-10500
ARM_NAME = B,R,Z
ARM_WAVELENGTH_RANGE = 3600-5800,5760-7620,7520-9824

# TOL_WAVELENGTH: Wavelength tolerance (in Angstrom) for brute-force peak-to-emission-line
# matching. A detected peak is considered matched to a known line if the
# observed wavelength falls within ±TOL_WAVELENGTH of the redshifted line.
# Default: 10
TOL_WAVELENGTH=10


# --- CWT 特征检测参数 ---
# SNR 阈值：CWT 系数 / 局域噪声下限，越大越严格
# Default: 5.0
CWT_SNR_THRESH=8.0
# 最小脊线长度：特征需在多少个尺度上被检测到才算有效
# Default: 2
CWT_MIN_RIDGE_LENGTH=4
# 小波尺度数量（对数均匀分布）
# Default: 24
CWT_N_SCALES=24
# 最小尺度（像素），对应最窄谱线 ≈ min_scale × 2.355 px FWHM
# Default: 1.0
CWT_MIN_SCALE=1.0
# 最大尺度（像素），对应最宽谱线 ≈ max_scale × 2.355 px FWHM
# Default: 80.0
CWT_MAX_SCALE=80.0