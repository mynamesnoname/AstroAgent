###############################################################################
# overall Configuration
###############################################################################
# Retry Configuration
MAX_TRIES=3
# Retry delay in seconds
RETRY_DELAY=180

###############################################################################
# LLM Configuration
###############################################################################

# LLM Configuration
LLM_API_KEY=
LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
LLM_MODEL=qwen3-max

# LLM_TEMPERATURE Default is 0.1
LLM_TEMPERATURE=
# LLM_MAX_TOKENS Default is None
LLM_MAX_TOKENS=
# DeepSeek V4 / Qwen3 等支持 thinking 的模型，
# - disabled: 关闭思考模式，回避多轮工具调用中 reasoning_content 回传问题
# - enabled: 开启思考模式
# - none: Recommend for Qwen series
LLM_THINKING=none

# Visual LLM Configuration
VLM_API_KEY=
VLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VLM_MODEL=qwen-vl-max
# VIS_LLM_TEMPERATURE Default is 0.1
VLM_TEMPERATURE=
# VIS_LLM_MAX_TOKENS Default is None
VLM_MAX_TOKENS=
VLM_THINKING=none

################################################################################
# MCP Configuration
################################################################################

# MCP config path
MCP_CONFIG=/home/wbc/code3/llm-spectro-agent_advance/configs/mcp_config.json
# MCP server port, script path and startup timeout (seconds)
# Remember to check with ss -tlnp | grep 8765
MCP_SERVER_PORT=8765
MCP_SERVER_SCRIPT=/home/wbc/code3/llm-spectro-agent_advance/src/AstroAgent/mcp_tools/spectro_server.py
MCP_STARTUP_TIMEOUT=15

################################################################################
# Prompts Configuration
################################################################################

# Prompt config path
PROMPTS_CONFIG_PATH=/home/wbc/code3/llm-spectro-agent_advance/configs/prompt_config_EN.json

# Prompts root directory
PROMPTS_ROOT=/home/wbc/code3/llm-spectro-agent_advance/prompt_content

################################################################################
# IO Configuration
################################################################################
# Run mode, single run or batch run
# RUN=s or b
# s for single run, b for batch run
RUN_MODE=s

# Input Directory
# Directory where input files are stored
INPUT_DIR=/home/wbc/code3/llm-spectro-agent_advance/data/QSO/fits_input
INPUT_FORMAT=fits
# Output Directory
# Directory where results will be stored
OUTPUT_DIR=/home/wbc/code3/llm-spectro-agent_advance/data/output

# Single mode parameters
# If RUN=s, set the image name to be processed (e.g., set IMAGE_NAME=QSO for QSO.png)
# Image name for a single image (without extension)
FILE_NAME=230

# Batch mode parameters
# If you set RUN=b, and your images are named QSO_0.png to QSO_100.png, set the following:
# BATCH_HEADER=QSO_             # Base name for a series of images, leave it empty if you don't have a header
# BATCH_START=0                 # Starting index of the image series
# BATCH_END=100                 # Ending index of the image series
# The program will automatically jump the image if the image does not exist.
FILE_BATCH_HEADER=
FILE_BATCH_START=4
FILE_BATCH_END=5

################################################################################
# Parameters
################################################################################

# OCR program
# Set the OCR program, 'tesseract' or 'paddle'. 
# Default is 'paddle'
OCR=paddle

# Minimum QSO redshift for the survey
MIN_QSO_REDSHIFT=0.01
# Minimum Galaxy redshift for the survey
MIN_GALAXY_REDSHIFT=

# Step F concurrency: number of F_a hypotheses analysed in parallel after the first.
# The first hypothesis is always run serially to warm up the prefix cache.
# Set to 1 for fully serial (best cache hit rate), higher for speed.
# Default: 4
STEP_F_CONCURRENCY=8

# Camera information, unit should align with the input .png file. 
# You can leave it empty if you don't have the information.
# e.g. for DESI:
# ARM_NAME = B,R,Z
# ARM_WAVELENGTH_RANGE = 3600-5800,5760-7620,7520-9824
ARM_NAME = B,R,Z
ARM_WAVELENGTH_RANGE = 3600-5800,5760-7620,7520-9824

# Optional Parameters for Signal Processing

# Absorption Line Detection Parameters
# Window settings
ABS_WINDOW_WIDTH=100
ABS_WINDOW_OVERLAP=60
# Significance thresholds
ABS_DELTA_CHI2_BASE=0.02
ABS_DYNAMIC_THRESHOLD_FACTOR=100
ABS_GLOBAL_DELTA_CHI2_THRESHOLD=0.5
# Line width limits (Angstrom)
ABS_FWHM_MIN=5.0
ABS_FWHM_MAX=100.0
# Depth SNR threshold
ABS_SNR_DEPTH_THRESHOLD=3.0
# Smoothed trough prior parameters
SMOOTH_SIGMA_TROUGH=160.0
SMOOTH_PROMINENCE_FRAC_TROUGH=0.01

# Emission Line Detection Parameters
# Window settings
EM_WINDOW_WIDTH=500
EM_WINDOW_OVERLAP=300
# Significance thresholds
EM_DELTA_CHI2_BASE=0.03
EM_DYNAMIC_THRESHOLD_FACTOR=100.0
EM_GLOBAL_DELTA_CHI2_THRESHOLD=0.05
# Systematic error fraction
EM_SYS_ERR_FRAC=0.05
# Line width limits (Angstrom)
EM_FWHM_MIN=3.0
EM_FWHM_MAX=380.0
# Smoothed peak prior parameters
SMOOTH_SIGMA=160.0
SMOOTH_PROMINENCE_FRAC=0.01

# TOL_WAVELENGTH: Wavelength tolerance (in Angstrom) for brute-force peak-to-emission-line
# matching. A detected peak is considered matched to a known line if the
# observed wavelength falls within ±TOL_WAVELENGTH of the redshifted line.
# QSO/ELG use a larger tolerance (broad/shifted lines); LRG/BGS use a tighter
# tolerance (narrow absorption/stellar lines with well-defined centroids).
# Default is 100 Å (QSO/ELG) / 30 Å (LRG/BGS).
TOL_WAVELENGTH_QSO=100
TOL_WAVELENGTH_GALAXY=30

# DISCUSSION_ROUNDS: Number of critique+patch discussion rounds per analysis path
# before the cross-type verdict. Each round independently reviews and patches
# the hypotheses within each path (QSO/ELG/LRG). Higher values increase
# computation cost but may improve robustness.
# Default: 1
DISCUSSION_ROUNDS=1